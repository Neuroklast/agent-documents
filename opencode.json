{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "rm -rf*": "deny",
      "git push*": "ask",
      "git push --force*": "deny",
      "git commit*": "ask"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    },
    "architect": {
      "mode": "subagent",
      "prompt": "{file:./roles/architect.md}",
      "permission": {
        "edit": "deny"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "prompt": "{file:./roles/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow"
        }
      }
    },
    "tester": {
      "mode": "subagent",
      "prompt": "{file:./roles/tester.md}"
    },
    "security-auditor": {
      "mode": "subagent",
      "prompt": "{file:./roles/security-auditor.md}",
      "permission": {
        "edit": "deny"
      }
    },
    "compliance-officer": {
      "mode": "subagent",
      "prompt": "{file:./roles/compliance-officer.md}",
      "permission": {
        "edit": "deny"
      }
    }
  }
}
